# AC-2 (standard): under Assurance: standard the review condition AC-4 is unmet
# with `review_pending` before the gate, met after it without a check record so
# ha done completes, and unmet again with `review_head_stale` after a commit.
include review-kind-goal
replace $GOAL/SPEC.md "Assurance: strict" "Assurance: standard"
commit "standard goal with a review condition"
ha start $GOAL --request "implement the synthetic goal" --rules run-rules/8
expect-exit 0
include rules-v7-implement
ha check $GOAL --baseline
expect-exit 0
ha check $GOAL
expect-exit 0
expect-records 5
expect-satisfied AC-3
expect-unsatisfied AC-4
expect-reasons AC-4:review_pending review_missing
ha done $GOAL
expect-exit 1
expect-completion-record absent
ha note $GOAL review --gate .git/gate.json
expect-exit 0
expect-satisfied AC-4
expect-reasons none
ha done $GOAL
expect-exit 0
expect-completion-record present
write src/extra.txt "extra\n"
commit "a later code commit"
expect-unsatisfied AC-4
expect-reason review_pending AC-4
expect-reason review_head_stale
