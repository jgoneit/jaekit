# run-rules/4: a reported wait leaves elapsed time until the user's answer or
# the start of a later run; unreported gaps and runs stay elapsed.
ha start $GOAL --request "implement the synthetic goal" --rules run-rules/4
expect-exit 0
ha note $GOAL wait --reason "asked which greeting to use"
expect-exit 0
ha note $GOAL input --quote "hello로 해줘"
ha note $GOAL wait --reason "asked whether keep may change"
ha check $GOAL AC-2
expect-exit 0
rewrite-record 1 at "\"2026-01-01T00:00:00Z\""
rewrite-record 2 at "\"2026-01-01T00:10:00Z\""
rewrite-record 3 at "\"2026-01-01T01:10:00Z\""
rewrite-record 4 at "\"2026-01-01T01:20:00Z\""
rewrite-record 5 started_at "\"2026-01-01T01:50:00Z\""
rewrite-record 5 at "\"2026-01-01T01:50:02Z\""
ha status $GOAL --format json
expect-output "\"reported_wait_seconds\": 5398"
