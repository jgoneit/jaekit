# run-rules/8: a pre-approved run limit is refused without a record; a quoted
# run limit change records a budget change as under run-rules/7.
ha start $GOAL --request "implement the synthetic goal" --rules run-rules/8
expect-exit 0
ha budget $GOAL --preapprove 80 --window 1 --revision 1 --quote "80회까지는 알아서 늘려" --context "이 창의 사전 승인"
expect-exit 65
expect-output "a pre-approved run limit requires"
expect-output "this goal keeps run-rules/8"
expect-records 1
ha budget $GOAL --runs 60 --from 50 --window 1 --revision 1 --quote "검증 실행을 60회로 늘려" --context "이 창의 실행 상한 변경"
expect-exit 0
expect-records 2
expect-record 2 kind budget_change
ha status $GOAL --format json
expect-output "\"runs_limit\": 60"
