# run-record.md §4.8: under run-rules/5 a standard goal stays pending without a
# review gate; an unusable gate file is refused and changes nothing; a recorded
# gate that does not cover HEAD and the goal documents keeps it pending with its
# reasons and keeps no finding text, a plan-only gate of another head is both
# without a code round and stale; lowering the tier to light lets it complete.
replace $GOAL/SPEC.md "Status: Ready" "Status: Ready\nAssurance: standard"
replace $GOAL/PLAN.md "| AC-1 | change | `sh tests/greeting.sh` | tests/greeting.sh | T001 |" "| AC-1 | maintain | `sh tests/greeting.sh` | — | T001 |"
write tests/greeting.sh "grep -qx hello src/greeting.txt\n"
write src/greeting.txt "hello\n"
commit "a standard goal, implemented"
ha start $GOAL --request "implement the synthetic goal" --rules run-rules/5
expect-exit 0
expect-record 1 rules run-rules/5
progress T001 done
ha check $GOAL
expect-exit 0
expect-satisfied AC-1
expect-satisfied AC-2
expect-status incomplete
expect-reasons review_missing
ha done $GOAL
expect-exit 1
expect-completion-record absent
expect-records 4
write .git/broken-gate.json "{\"schema\":\"review-gate/v1\",\"state\":\"complete\"}\n"
ha note $GOAL review --gate .git/broken-gate.json
expect-exit 65
expect-output "nothing recorded"
expect-records 4
ha note $GOAL review --gate .git/missing-gate.json
expect-exit 65
expect-output "the file does not exist; nothing recorded"
expect-records 4
