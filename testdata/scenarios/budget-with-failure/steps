# run-rules/2: a failed condition is not hidden by budget_exceeded; no completion is recorded.
include implement
write src/greeting.txt "bye\n"
commit "break greeting"
ha check $GOAL
expect-exit 1
expect-status budget_exhausted
expect-reason criterion_failed AC-1
expect-reason budget_exceeded
ha done $GOAL
expect-exit 4
expect-completion-record none
