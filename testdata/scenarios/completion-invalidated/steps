expect-output "is no longer valid: code outside the bundle documents changed since that commit\n"
expect-output "- AC-1 `criterion_missing` (executor): no fresh record"
expect-deterministic
ha check $GOAL
expect-exit 0
ha note $GOAL reopen --quote "느낌표도 붙여줘"
ha status $GOAL
expect-output "is no longer valid: code outside the bundle documents changed since that commit; reopened at seq 8; run `ha done docs/specs/greet` to record completion"
append docs/specs/greet/SPEC.md "\nOne more sentence.\n"
replace docs/specs/greet/PLAN.md "`sh tests/keep.sh`" "`sh ./tests/keep.sh`"
