# run-record.md §1.3 and §4.8: under run-rules/5 a review note keeps the
# gate's lists of deferred findings and findings without a disposition with
# no finding text; a gate whose lists are malformed is refused and changes
# nothing; ha report shows the lists on its To review line, says a stored list
# that a hand edit broke cannot be read while the reasons stay the same, and
# says a gate without the lists recorded none.
replace $GOAL/SPEC.md "Status: Ready" "Status: Ready\nAssurance: standard"
replace $GOAL/PLAN.md "| AC-1 | change | `sh tests/greeting.sh` | tests/greeting.sh | T001 |" "| AC-1 | maintain | `sh tests/greeting.sh` | — | T001 |"
write tests/greeting.sh "grep -qx hello src/greeting.txt\n"
write src/greeting.txt "hello\n"
commit "a standard goal, implemented"
ha start $GOAL --request "implement the synthetic goal" --rules run-rules/5
expect-exit 0
progress T001 done
ha check $GOAL
expect-exit 0
expect-records 3
