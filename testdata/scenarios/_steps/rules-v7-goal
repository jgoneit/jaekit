write checks/feature.json "{\"schema\":\"check-declaration/v1\",\"producer\":\"scenario-value\",\"producer_version\":\"1\",\"producer_paths\":[\"checks/feature.sh\"],\"targets\":[{\"id\":\"value\",\"violation\":\"value-wrong\"}]}\n"
