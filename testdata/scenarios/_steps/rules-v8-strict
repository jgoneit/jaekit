# A strict rules-v7-goal whose maintain check writes .git/gate.json: a complete
# synthetic gate with a plan round and a candidate round from the start base to HEAD.
include rules-v7-goal
replace $GOAL/SPEC.md "Status: Ready" "Status: Ready\nAssurance: strict"
write tests/keep.sh "set -eu\ngrep -qx keep src/keep.txt\npython3 tests/gate.py\n"
write tests/gate.py "import hashlib, json, subprocess\nfrom pathlib import Path\ng = Path('docs/specs/greet')\nbase = json.loads((g / 'runs.jsonl').read_text().splitlines()[0])['base_commit']\nhead = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()\ndocs = [{'name': p.as_posix(), 'sha256': hashlib.sha256(p.read_bytes()).hexdigest()} for p in (g / 'SPEC.md', g / 'contract.md')]\nz = '0' * 64\nrounds = [{'path': 'docs/reviews/greet/%02d-%s' % (n, s), 'stage': s, 'sequence': n, 'base': base, 'head': h, 'criteria_digest': z, 'criteria': docs, 'packet_digest': z, 'config_digest': z, 'requested_reviewers': ['host'], 'required_reviewers': 1, 'completed_required': 1, 'dry_run': False, 'counted': True} for n, (s, h) in enumerate([('plan', base), ('candidate', head)], 1)]\ngate = {'schema': 'review-gate/v1', 'spar_version': '0.1.6', 'state': 'complete', 'reasons': [], 'expect_head': head, 'last_reviewed_head': head, 'previous_gate_digest': None, 'rounds': rounds, 'open': {'defect': 0, 'requirement-question': 0}, 'open_findings': [], 'auto_deferred': 0, 'growth': {'added_lines': {'check': 0, 'other': 0}, 'over_hardening': False, 'rounds': []}, 'written_at': '2026-01-01T00:00:00Z'}\nPath('.git/gate.json').write_text(json.dumps(gate) + chr(10))\n"
