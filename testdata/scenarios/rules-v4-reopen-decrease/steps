# run-rules/4: reopen carries the start limit or the last quoted limit, lowered
# by a later decrease below it. A reason alone lowers the limit, and a
# decrease after a quoted raise stays carried even above the window's
# starting limit.
ha start $GOAL --request "implement the synthetic goal" --rules run-rules/4
expect-exit 0
ha budget $GOAL --runs 40 --from 50 --window 1 --revision 1 --reason "fewer checks"
expect-exit 0
ha note $GOAL reopen --quote "다시 이어서 해줘"
expect-exit 0
ha status $GOAL --format json
expect-output "\"runs_limit\": 40"
ha budget $GOAL --runs 60 --from 40 --window 3 --revision 3 --quote "60회로 늘려" --context "사용자가 정한 이 창의 상한"
expect-exit 0
ha budget $GOAL --runs 55 --from 60 --window 3 --revision 4 --reason "fewer checks"
expect-exit 0
ha note $GOAL reopen --quote "한 번 더 이어서 해줘"
expect-exit 0
ha status $GOAL --format json
expect-output "\"runs_limit\": 55"
