# run-rules/8: every baseline overlays the check paths of all marked change
# conditions. AC-1's check sources a HEAD-only helper that only AC-2 lists;
# a later change to AC-2's check alone leaves AC-1's baseline stale, and so
# does unmarking AC-2 while every overlay digest still equals HEAD.
include rules-v7-goal
replace $GOAL/PLAN.md "checks/feature.json | T001 | — |" "checks/feature.json, checks/helper.sh | T001 | 요구 |"
commit "two marked change conditions"
ha start $GOAL --request "implement the synthetic goal" --rules run-rules/8
expect-exit 0
write checks/helper.sh "want=hello\n"
replace checks/greeting.sh "set -eu\n" "set -eu\n. checks/helper.sh\n"
replace checks/greeting.sh "= hello ]" "= \"$want\" ]"
include rules-v7-implement
ha check $GOAL --baseline AC-1
expect-exit 0
expect-record 2 result fail_as_expected
expect-record 2 overlay "[{\"path\":\"checks/feature.json\",\"digest\":\"7e444033879a88aac4c6f6f0f5e10400facbb94e02efcc9c9d32025808362104\"},{\"path\":\"checks/feature.sh\",\"digest\":\"880843df37b77e542f3643bd58403e291ffc226985d204459afbd38fc255feb3\"},{\"path\":\"checks/greeting.json\",\"digest\":\"d582cbfd842d22a03e134a79d602b03beb240fbdcafed167f4b98669b31c7074\"},{\"path\":\"checks/greeting.sh\",\"digest\":\"4ae7422a2689d9b3b093c9ceb7e3ce51b7cfe0433263fa60eb8f992652918e7a\"},{\"path\":\"checks/helper.sh\",\"digest\":\"88824db90eb63fc3617726cacffa11a692eaa50bdd469cc213561db11cc81f92\"}]"
ha check $GOAL --baseline AC-2
expect-exit 0
expect-record 3 result fail_as_expected
expect-record 3 overlay "[{\"path\":\"checks/feature.json\",\"digest\":\"7e444033879a88aac4c6f6f0f5e10400facbb94e02efcc9c9d32025808362104\"},{\"path\":\"checks/feature.sh\",\"digest\":\"880843df37b77e542f3643bd58403e291ffc226985d204459afbd38fc255feb3\"},{\"path\":\"checks/greeting.json\",\"digest\":\"d582cbfd842d22a03e134a79d602b03beb240fbdcafed167f4b98669b31c7074\"},{\"path\":\"checks/greeting.sh\",\"digest\":\"4ae7422a2689d9b3b093c9ceb7e3ce51b7cfe0433263fa60eb8f992652918e7a\"},{\"path\":\"checks/helper.sh\",\"digest\":\"88824db90eb63fc3617726cacffa11a692eaa50bdd469cc213561db11cc81f92\"}]"
ha check $GOAL
expect-exit 0
expect-reasons none
append checks/feature.sh "# AC-2's check, clarified.\n"
commit "change only the AC-2 check"
ha check $GOAL
expect-exit 0
expect-reasons AC-1:baseline_missing AC-2:baseline_missing
# A new AC-1 baseline is fresh; then only the marks change.
ha check $GOAL --baseline AC-1
expect-exit 0
expect-record 10 result fail_as_expected
expect-reasons AC-2:baseline_missing
replace $GOAL/PLAN.md "checks/helper.sh | T001 | 요구 |" "checks/helper.sh | T001 | — |"
commit "AC-2 no longer marked"
expect-reasons AC-1:baseline_missing
