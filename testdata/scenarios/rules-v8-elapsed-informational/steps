# run-rules/8: the PLAN's elapsed-time line is optional and never limits the
# budget; reported waits are still recorded and shown by ha cost.
include rules-v7-goal
replace $GOAL/PLAN.md "- 경과 시간: 4시간\n" ""
commit "no elapsed-time line"
ha start $GOAL --request "implement the synthetic goal" --rules run-rules/8
expect-exit 0
ha lint $GOAL
expect-exit 0
expect-status incomplete
# ha status exits with the status: 1 is incomplete (record_invalid would be 2).
ha status $GOAL
expect-exit 1
expect-no-output "record_invalid"
expect-no-output "invalid start budget"
# Start the bundle again with a one-minute line, then exceed it by two hours.
rm $GOAL/runs.jsonl
replace $GOAL/PLAN.md "- 비용: 미관측" "- 경과 시간: 1분\n- 비용: 미관측"
commit "one-minute elapsed-time line"
ha start $GOAL --request "implement the synthetic goal" --rules run-rules/8
expect-exit 0
ha note $GOAL wait --reason "asked which greeting to use"
expect-exit 0
ha note $GOAL resume
expect-exit 0
expect-records 3
expect-record 2 note wait
expect-record 3 note resume
rewrite-record 1 at "\"2026-01-01T00:00:00Z\""
rewrite-record 2 at "\"2026-01-01T02:00:00Z\""
rewrite-record 3 at "\"2026-01-01T03:00:00Z\""
expect-no-reason budget_exceeded
expect-status incomplete
ha status $GOAL
expect-exit 1
expect-output "/60 seconds"
expect-no-output "(exceeded)"
ha cost $GOAL
expect-exit 0
expect-output "  - seq 2, 3599 seconds: asked which greeting to use"
