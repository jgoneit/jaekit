# run-rules/4: a recovery takes out only the error records it named. Errors of
# an input that changed and came back count again.
ha start $GOAL --request "implement the synthetic goal" --rules run-rules/4
expect-exit 0
ha-without-runner check $GOAL AC-2
ha-without-runner check $GOAL AC-2
expect-reason AC-2:error_limit
append $GOAL/PLAN.md "\n## 시간 제한\n- AC-2: 10분\n"
expect-no-reason AC-2:error_limit
ha-without-runner check $GOAL AC-2
ha-without-runner check $GOAL AC-2
expect-reason AC-2:error_limit
ha note $GOAL recover AC-2 --input check --change "runner restored on PATH"
expect-exit 0
expect-record 6 recovery "{\"criterion\":\"AC-2\",\"input\":\"check\",\"change\":\"runner restored on PATH\",\"clears\":[4,5]}"
expect-no-reason AC-2:error_limit
replace $GOAL/PLAN.md "\n## 시간 제한\n- AC-2: 10분\n" ""
expect-reason AC-2:error_limit
