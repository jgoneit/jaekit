# go-test-json: a descendant that holds standard output past ha's drain bound
# makes the run a wait error, even after a nonzero exit with a marked failure.
replace $GOAL/PLAN.md "`sh tests/greeting.sh` | tests/greeting.sh |" "`sh tests/gotest.sh` | tests/gotest.sh, checks/AC-1.json |"
append $GOAL/PLAN.md "\n## 결과 계약\n| ID | 선언 경로 |\n| --- | --- |\n| AC-1 | checks/AC-1.json |\n"
commit "link the greeting test"
ha start $GOAL --request "implement the synthetic goal" --rules run-rules/4
expect-exit 0
ha check $GOAL --baseline AC-1
expect-record 2 result error
expect-output "classification: process_wait"
