# run-rules/8 keeps run-rules/7's run limit, selective baselines and strict
# review gate: over the limit with another reason is budget_exhausted, the
# unmarked AC-2 passes without a baseline, and only a gate lets it complete.
include rules-v8-strict
replace $GOAL/PLAN.md "검증 실행: 자동" "검증 실행: 4"
commit "strict goal with a four-run limit"
ha start $GOAL --request "implement the synthetic goal" --rules run-rules/8
expect-exit 0
include rules-v7-implement
ha check $GOAL --baseline
expect-exit 0
expect-records 2
expect-record 2 result fail_as_expected
ha check $GOAL
expect-exit 0
expect-records 5
expect-satisfied AC-2
expect-attempt AC-2 baselines 0
expect-reasons review_missing
ha done $GOAL
expect-exit 1
expect-completion-record absent
ha check $GOAL AC-3
expect-exit 0
expect-status budget_exhausted
expect-reasons budget_exceeded review_missing
ha note $GOAL review --gate .git/gate.json
expect-exit 0
expect-reasons none
ha done $GOAL
expect-exit 0
expect-completion-record present
