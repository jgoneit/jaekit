# run-rules/4: a reasoned edit of a base test inside the recorded authority
# needs no confirmation; an edit after the reason is held again.
ha start $GOAL --request "keep 테스트도 필요하면 고쳐줘" --rules run-rules/4 --test-authority "tests/** 안의 기존 시험을 고쳐도 된다"
expect-exit 0
expect-record 1 rules run-rules/4
write tests/keep.sh "test -f src/keep.txt\n"
commit "tighten keep test"
expect-reason test_definition_changed
ha note $GOAL test-change tests:tests/keep.sh --criteria AC-2 --how "src/keep.txt가 남아 있는지 본다" --weakened
expect-exit 0
expect-reason test_definition_changed
ha note $GOAL test-change tests:tests/keep.sh --criteria AC-2 --how "src/keep.txt가 남아 있는지 본다"
expect-exit 0
expect-no-reason test_definition_changed
ha status $GOAL --format json
expect-output "\"exempt\": true"
expect-output "\"claim\": \"executor\""
ha status $GOAL
expect-output "`tests/keep.sh` modified (blob "
write tests/keep.sh "exit 0\n"
commit "relax keep test"
expect-reason test_definition_changed
ha status $GOAL --format json
expect-output "the file changed after the reason"
ha note $GOAL confirm tests:tests/keep.sh --quote "keep 테스트 수정 승인"
expect-exit 0
expect-no-reason test_definition_changed
