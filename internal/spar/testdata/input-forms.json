  "agy_commands": {
    "about": "G11: agy shell commands. accepted and kept lines are not violations (kept ones were accepted before the change that joined commands); every violations line is tool_violation, and its reason names the line and problem, the first problem: a shell construct anywhere in the line, else the first part, read from the left, that breaks the rule.",
    "accepted": [
      "ls -la && ls -la head base",
      "ls -la && ls -la head/ && ls -la base/",
      "pwd && ls -la",
      "diff -u base/a.md head/a.md; diff -u base/b.md head/b.md",
      "diff -u base/plugins/seal/ head/plugins/seal/ ; diff -u base/plugins/spar/ head/plugins/spar/",
      "ls -la head/tools/goal-checks 2>&1 || true",
      "grep -rn x head | head -20 && wc -l head/a.go",
      "grep -n \"a && b; c\" head/a.go",
      "grep -c '|' head/a.go || true",
      "sed -n '1,20p' head/a.go && sed -n '/func/,/^}/p' head/b.go",
      "ls head;ls base"
    ],
    "kept": [
      "ls -la head",
      "grep -rn foo head | head -20",
      "sed -n '1,40p' head/a.go",
      "find head -name '*.go'",
      "grep -o foo head/a",
      "grep -rn greet head 2>/dev/null",
      "cat head/app/main.go 2>&1",
      "sed -n -e '1p' -e '/x/,/y/p' head/a",
      "grep -n '$HOME' head/a",
      "grep -n \"\\$x\" head/a"
    ],
