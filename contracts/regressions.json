    {
      "id": "I1",
      "basis": [
        "AGENTS.md",
        "tools/review-checks/README.md",
        "tools/gap-checks/README.md"
      ],
      "property": "Current-file checks do not need private goals, raw logs, or missing history. Explicit history audits report their required range separately."
    },
    {
      "id": "I2",
      "basis": [
        "contracts/check-result.md",
        "contracts/run-record.md"
      ],
      "property": "Observed pass, requirement violation, unexpected assertion, environment failure, missing execution and retries retain their meaning through producers and stored consumers."
    },
    {
      "id": "I3",
      "basis": [
        "tools/review-checks/README.md",
        "tools/gap-checks/README.md"
      ],
      "property": "Request binding and uncertainty survive all supported observation consumers. Text existence is not actual execution."
    },
    {
      "id": "I4",
      "basis": [
        "AGENTS.md",
        "tools/verify.py",
        ".github/workflows/ci.yml"
      ],
      "property": "Required preflight executables are the executables used; missing tools and failed selected checks cannot yield shared verification success."
    },
    {
      "id": "I5",
      "basis": [
        "AGENTS.md",
        "tools/check_public_tree.py"
      ],
      "property": "Public scanning distinguishes its rule definitions and synthetic fixtures without exempting arbitrary input filenames or required path information."
    }
